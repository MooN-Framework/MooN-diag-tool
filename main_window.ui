  <property name="styleSheet">
   <string notr="true">/* Light, professional MainWindow style */
QMainWindow {
    background-color: #f7f8fa;       /* very light gray background */
    border: 1px solid #e0e0e0;       /* subtle border around window */
    border-radius: 10px;              /* slightly rounded corners */
}

/* Optional: Central widget card effect */
QWidget#centralwidget {
    background-color: #ffffff;        /* white “card” inside the window */
    border: 1px solid #dddddd;        /* light border for central widget */
    border-radius: 8px;
    padding: 8px;                     /* inner spacing */
}

/* QPushButton style to match */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 5px 12px;
    color: #333333;
    font-size: 11pt;
}

QPushButton:hover {
    background-color: #e6f0ff;        /* subtle hover effect */
    border-color: #99c2ff;
}

QPushButton:pressed {
    background-color: #cce0ff;        /* pressed effect */
}</string>
  </property>
